// src/omnichain/router.rs

use deadpool_redis::Pool;
use redis::Script;
use std::sync::Arc;
use uuid::Uuid;

use super::provider::{SorError, SorProvider};
use super::scripts::LUA_ROUTE_LOCK;

pub struct SmartOrderRouter {
    pub provider: Arc<Box<dyn SorProvider>>,
    pub pool: Pool,
    pub script: Script,
}

impl SmartOrderRouter {
    pub fn new(provider: Arc<Box<dyn SorProvider>>, pool: Pool) -> Self {
        Self {
            provider,
            pool,
            script: Script::new(LUA_ROUTE_LOCK),
        }
    }

    pub async fn request_route_lock(
        &self,
        _user_id: &str, 
        src_asset: &str,
        dst_asset: &str,
        amount: f64,
        max_slippage: f64,
    ) -> Result<(String, f64), SorError> {
        let mut conn = self
            .pool
            .get()
            .await
            .map_err(|e| SorError::PoolError(e.to_string()))?;

        let pair = format!("{}_{}", src_asset.to_uppercase(), dst_asset.to_uppercase());
        let depth_key = format!("dev:sor:depth:{}", pair);
        
        let lock_id = Uuid::new_v4().to_string();
        let lock_key = format!("dev:sor:lock:{}", lock_id);
        let ttl_seconds = 15;

        let result: Vec<String> = self
            .script
            .key(&depth_key)
            .key(&lock_key)
            .arg(amount)
            .arg(max_slippage)
            .arg(ttl_seconds)
            .invoke_async(&mut conn)
            .await
            .map_err(SorError::Redis)?;

        if result.is_empty() {
            return Err(SorError::PoolError("Empty response from Lua execution pipeline".into()));
        }

        match result[0].as_str() {
            "ok" => {
                let impact_rate = result.get(1)
                    .and_then(|s| s.parse::<f64>().ok())
                    .unwrap_or(0.0);
                Ok((lock_id, impact_rate))
            }
            "err" => {
                let err_reason = result.get(1).map(String::as_str).unwrap_or("UNKNOWN_FAULT");
                match err_reason {
                    "INSUFFICIENT_LIQUIDITY" => Err(SorError::InsufficientLiquidity(pair)),
                    "SLIPPAGE_EXCEEDED" => Err(SorError::SlippageViolation),
                    "ROUTE_BUSY" => Err(SorError::BroadcastFailure("Route lock collision. Try again.".into())),
                    _ => Err(SorError::PoolError(format!("Lua generic fault: {}", err_reason))),
                }
            }
            _ => Err(SorError::PoolError("Invalid Lua protocol payload structure".into())),
        }
    }
}
