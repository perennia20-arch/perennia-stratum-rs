# Perennia v1.0 Production Environment Template (Zero Secret Echo Safe)
# Generate random hex secrets using: ./rotate-secrets-zero-echo.sh /etc/perennia/.env

RUST_BIND_ADDRESS=127.0.0.1:8002
AGENT_BIND_ADDRESS=127.0.0.1:8003
RUST_BACKEND_URL=http://127.0.0.1:8002
AGENT_BACKEND_URL=http://127.0.0.1:8003
AGENT_EDGE_MAX_CONCURRENCY=2048

POSTGRES_USER=perennia
POSTGRES_PASSWORD=<CHANGE_ME_CSPRNG_32_HEX>
POSTGRES_DB=perennia_prod
DATABASE_URL=postgres://perennia:<CHANGE_ME_CSPRNG_32_HEX>@127.0.0.1:5432/perennia_prod
REDIS_URL=redis://127.0.0.1:6379

KASPAD_GRPC_URL=grpc://127.0.0.1:16110
PERENNIA_MASTER_TREASURY_KAS=kaspa:<CHANGE_ME_MASTER_TREASURY_ADDR>
MASTER_TREASURY_PUBKEY=<CHANGE_ME_64_HEX_XONLY_FOUNDER_PUBKEY>
PERENNIA_HOT_KAS_ADDRESS=kaspa:<CHANGE_ME_STRATUM_HOT_ADDR_ISOLATED>
PERENNIA_COLD_KAS_ADDRESS=kaspa:<CHANGE_ME_COLD_AIRLOCK_ADDR>

INTERNAL_ADMIN_TOKEN=<CHANGE_ME_CSPRNG_64_HEX>
PERENNIA_ADMIN_KEY=<CHANGE_ME_CSPRNG_64_HEX>
AGENT_INTERNAL_SERVICE_SECRET=<CHANGE_ME_CSPRNG_64_HEX>
AGENT_MACAROON_SECRET=<CHANGE_ME_CSPRNG_64_HEX>
LEDGER_HMAC_SECRET=<CHANGE_ME_CSPRNG_64_HEX>
KYC_MASTER_KEY=<CHANGE_ME_CSPRNG_64_HEX>

SOLVER_PRIVATE_KEY_HEX=<CHANGE_ME_CSPRNG_SOLVER_64_HEX>
SOLVER_WALLET_ADDRESS=kaspa:<CHANGE_ME_SOLVER_ADDR>

STRIPE_SECRET_KEY=sk_live_<CHANGE_ME>
STRIPE_WEBHOOK_SECRET=whsec_<CHANGE_ME>
MERCURY_WEBHOOK_SECRET=<CHANGE_ME>
CHANGENOW_API_KEY=<CHANGE_ME>

PUBLIC_ORIGIN=https://perennia.io
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
